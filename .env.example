DISCORD_TOKEN=seu_token_aqui
OWNER_IDS=123456789012345678
GUILD_IDS=123456789012345678
DATABASE_PATH=kibot.db

# GIFs de reação separados por vírgula. Opcional.
GIF_URLS=https://example.com/reacao1.gif,https://example.com/reacao2.gif


# IA conversacional do Kibot (Google Gemini API)
# Gere sua chave gratuitamente no Google AI Studio.
GEMINI_API_KEY=cole_sua_chave_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_COOLDOWN=8

# Dados recentes
# Clima usa Open-Meteo e não precisa de chave.
FOOTBALL_DATA_API_KEY=
FOOTBALL_COMPETITIONS=PL,PD,SA,BL1,FL1,CL,BR1
GNEWS_API_KEY=
REALTIME_CACHE_SECONDS=60

# Moderação por cargo (fallback quando o bot não possui Moderar Membros).
# O cargo precisa existir e estar abaixo do cargo do Kibot.
MUTE_ROLE_ID=

# XP 2x: dono do bot (OWNER_IDS) e cargo Booster.
XP_BOOSTER_ROLE_ID=1541152198325575690

# Site + dashboard (opcional; deixe WEB_ENABLED=0 se não quiser iniciar o site)
WEB_ENABLED=1
WEB_PUBLIC_URL=https://SEU-DOMINIO
WEB_SESSION_SECRET=gere-uma-chave-secreta-grande
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
BOT_INVITE_URL=
